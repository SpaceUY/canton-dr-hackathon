-- Scaffold placeholder to prove the build/upload pipeline works end to end.
-- Replace with BackupPolicy / CustodianAgreement / Challenge / RecoveryRequest
-- (see plan step 1 in ../CLAUDE.md).
module Ping where

template Ping
  with
    sender : Party
    receiver : Party
  where
    signatory sender
    observer receiver

    choice Pong : ()
      controller receiver
      do pure ()
