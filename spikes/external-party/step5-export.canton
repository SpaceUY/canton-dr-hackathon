import com.digitalasset.canton.topology.ParticipantId

val partyId = PartyId.tryFromProtoPrimitive("spike4::122071913dc66644f65e0a4a1b15a4dc2dec2f9b1c6f9115a02c472201466352f27d")
val synchronizerId = participant2.synchronizers.id_of("da")
val target3Id = ParticipantId.tryFromProtoPrimitive("PAR::participant3::1220c08ac930f706c3647d2702a6a40ba1c4145f3b4a2d940d0fbcf9bff6f8fcb74c")

participant2.parties.export_party_acs(
  party = partyId,
  synchronizerId = synchronizerId,
  targetParticipantId = target3Id,
  beginOffsetExclusive = 184L,
  exportFilePath = "/spike/spike4.acs.gz",
)

println("EXPORT_OK")
