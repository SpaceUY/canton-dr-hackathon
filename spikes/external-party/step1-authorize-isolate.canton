import com.digitalasset.canton.topology.transaction.ParticipantPermission

val partyId = PartyId.tryFromProtoPrimitive("spike4::122071913dc66644f65e0a4a1b15a4dc2dec2f9b1c6f9115a02c472201466352f27d")
val synchronizerId = participant3.synchronizers.id_of("da")

// Step 3: Target Authorization (target consents to host, while still connected)
val proposal = participant3.topology.party_to_participant_mappings.propose_delta(
  party = partyId,
  adds = Seq((participant3.id, ParticipantPermission.Observation)),
  store = synchronizerId,
  requiresPartyToBeOnboarded = true,
)
val hashBytes = proposal.hash.hash.getCryptographicEvidence.toByteArray
println(s"PROPOSAL_HASH_B64:${java.util.Base64.getEncoder.encodeToString(hashBytes)}")

// Step 4: Target Isolation
participant3.synchronizers.disconnect_all()

// Step 5: Disable auto-reconnect
participant3.synchronizers.modify("da", _.copy(manualConnect = true))

println("STEP1_OK")
