// Bootstraps the "da" synchronizer from sequencer1 + mediator1, connects the
// 3 participants to it, and pings between them as a smoke test.
bootstrap.synchronizer(
  synchronizerName = "da",
  sequencers = Seq(sequencer1),
  mediators = Seq(mediator1),
  synchronizerOwners = Seq(sequencer1),
  synchronizerThreshold = PositiveInt.one,
  staticSynchronizerParameters =
    StaticSynchronizerParameters.defaultsWithoutKMS(ProtocolVersion.forSynchronizer),
)

Seq(participant1, participant2, participant3, participant4).foreach { p =>
  p.synchronizers.connect("da", "http://synchronizer:5001")
}

utils.retry_until_true {
  Seq(participant1, participant2, participant3, participant4).forall(_.synchronizers.active("da"))
}

participant1.health.ping(participant2)
participant2.health.ping(participant3)

val darFile = new java.io.File("/canton/dars")
  .listFiles()
  .filter(_.getName.endsWith(".dar"))
  .headOption
  .getOrElse(sys.error("no .dar file found in /canton/dars — run `dpm build` in /daml first"))
  .getAbsolutePath
participants.all.dars.upload(darFile)

println("BOOTSTRAP_OK: 3 participants connected to synchronizer 'da', DAR uploaded")
